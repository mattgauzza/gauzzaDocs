{
  "name": "gauzzadocs",
  "version": "0.1.2",
  "private": true,
  "description": "A fast, Google Docs-style local editor for docs, sheets, PDFs and any text file, with a live CLI for agents",
  "main": "out/main/index.js",
  "bin": {
    "gdocs": "dist/cli.mjs",
    "gauzzadocs": "dist/cli.mjs"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/build-cli.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "dist": "npm run build && electron-builder --publish never",
    "marketplace": "node scripts/build-marketplace.mjs",
    "marketplace:check": "node scripts/build-marketplace.mjs --check",
    "icon": "electron scripts/make-icon.cjs",
    "release": "node scripts/release.mjs",
    "plugins:validate": "node scripts/validate-plugins.mjs"
  },
  "license": "MIT",
  "build": {
    "appId": "app.gauzzadocs.desktop",
    "productName": "gauzzaDocs",
    "asar": false,
    "files": [
      "out/**",
      "dist/cli.mjs",
      "resources/icon.png",
      "plugins/**",
      "src/shared/ops.md",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "resources/icon.png",
      "executableName": "gauzzaDocs"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "include": "build/installer.nsh",
      "artifactName": "gauzzaDocs-Setup-${version}.exe",
      "shortcutName": "gauzzaDocs"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mattgauzza",
        "repo": "gauzzaDocs"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "resources/icon.png",
      "artifactName": "gauzzaDocs-${version}-mac-${arch}.${ext}",
      "fileAssociations": [
        {
          "ext": [
            "docx"
          ],
          "name": "Word document",
          "description": "Word document",
          "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
          "role": "Editor"
        },
        {
          "ext": [
            "md",
            "markdown"
          ],
          "name": "Markdown document",
          "description": "Markdown document",
          "mimeType": "text/markdown",
          "role": "Editor"
        },
        {
          "ext": [
            "xlsx"
          ],
          "name": "Excel workbook",
          "description": "Excel workbook",
          "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
          "role": "Editor"
        },
        {
          "ext": [
            "csv"
          ],
          "name": "CSV file",
          "description": "CSV file",
          "mimeType": "text/csv",
          "role": "Editor"
        },
        {
          "ext": [
            "tsv"
          ],
          "name": "TSV file",
          "description": "TSV file",
          "mimeType": "text/tab-separated-values",
          "role": "Editor"
        },
        {
          "ext": [
            "pdf"
          ],
          "name": "PDF document",
          "description": "PDF document",
          "mimeType": "application/pdf",
          "role": "Editor"
        },
        {
          "ext": [
            "txt",
            "log"
          ],
          "name": "Text file",
          "description": "Text file",
          "mimeType": "text/plain",
          "role": "Editor"
        },
        {
          "ext": [
            "json"
          ],
          "name": "JSON file",
          "description": "JSON file",
          "mimeType": "application/json",
          "role": "Editor"
        },
        {
          "ext": [
            "yaml",
            "yml"
          ],
          "name": "YAML file",
          "description": "YAML file",
          "mimeType": "application/x-yaml",
          "role": "Editor"
        },
        {
          "ext": [
            "pptx"
          ],
          "name": "PowerPoint presentation",
          "description": "PowerPoint presentation",
          "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation",
          "role": "Editor"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "resources/icon.png",
      "maintainer": "gauzzaDocs contributors <gauzzadocs@users.noreply.github.com>",
      "artifactName": "gauzzaDocs-${version}-linux-${arch}.${ext}",
      "fileAssociations": [
        {
          "ext": [
            "docx"
          ],
          "name": "Word document",
          "description": "Word document",
          "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
          "role": "Editor"
        },
        {
          "ext": [
            "md",
            "markdown"
          ],
          "name": "Markdown document",
          "description": "Markdown document",
          "mimeType": "text/markdown",
          "role": "Editor"
        },
        {
          "ext": [
            "xlsx"
          ],
          "name": "Excel workbook",
          "description": "Excel workbook",
          "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
          "role": "Editor"
        },
        {
          "ext": [
            "csv"
          ],
          "name": "CSV file",
          "description": "CSV file",
          "mimeType": "text/csv",
          "role": "Editor"
        },
        {
          "ext": [
            "tsv"
          ],
          "name": "TSV file",
          "description": "TSV file",
          "mimeType": "text/tab-separated-values",
          "role": "Editor"
        },
        {
          "ext": [
            "pdf"
          ],
          "name": "PDF document",
          "description": "PDF document",
          "mimeType": "application/pdf",
          "role": "Editor"
        },
        {
          "ext": [
            "txt",
            "log"
          ],
          "name": "Text file",
          "description": "Text file",
          "mimeType": "text/plain",
          "role": "Editor"
        },
        {
          "ext": [
            "json"
          ],
          "name": "JSON file",
          "description": "JSON file",
          "mimeType": "application/json",
          "role": "Editor"
        },
        {
          "ext": [
            "yaml",
            "yml"
          ],
          "name": "YAML file",
          "description": "YAML file",
          "mimeType": "application/x-yaml",
          "role": "Editor"
        },
        {
          "ext": [
            "pptx"
          ],
          "name": "PowerPoint presentation",
          "description": "PowerPoint presentation",
          "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation",
          "role": "Editor"
        }
      ]
    }
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@turbodocx/html-to-docx": "^1.23.3",
    "@xmldom/xmldom": "^0.9.12",
    "commander": "^15.1.0",
    "diff": "^9.0.0",
    "electron-updater": "^6.8.11",
    "elkjs": "^0.10.2",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.13.0",
    "marked": "^18.3.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "pptxgenjs": "^4.0.1",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-code-block-lowlight": "^3.35.0",
    "@tiptap/extension-highlight": "^3.35.0",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-placeholder": "^3.35.0",
    "@tiptap/extension-table": "^3.35.0",
    "@tiptap/extension-task-item": "^3.35.0",
    "@tiptap/extension-task-list": "^3.35.0",
    "@tiptap/extension-text-align": "^3.35.0",
    "@tiptap/extension-text-style": "^3.35.0",
    "@tiptap/html": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.3.0",
    "codemirror": "^6.0.2",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "author": {
    "name": "gauzzaDocs contributors",
    "email": "gauzzadocs@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mattgauzza/gauzzaDocs.git"
  },
  "homepage": "https://github.com/mattgauzza/gauzzaDocs"
}
