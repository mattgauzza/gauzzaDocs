; The app writes its command-line launcher here on first start; take it away again on uninstall.
!macro customUnInstall
  Delete "$LOCALAPPDATA\Microsoft\WindowsApps\gdocs.cmd"
  Delete "$LOCALAPPDATA\Microsoft\WindowsApps\gauzzadocs.cmd"
  ; File types the app registered with Windows (src/main/winAssoc.ts).
  DeleteRegKey HKCU "Software\Classes\gauzzaDocs.docx"
  DeleteRegValue HKCU "Software\Classes\.docx\OpenWithProgids" "gauzzaDocs.docx"
  DeleteRegKey HKCU "Software\Classes\gauzzaDocs.md"
  DeleteRegValue HKCU "Software\Classes\.md\OpenWithProgids" "gauzzaDocs.md"
  DeleteRegKey HKCU "Software\Classes\gauzzaDocs.markdown"
  DeleteRegValue HKCU "Software\Classes\.markdown\OpenWithProgids" "gauzzaDocs.markdown"
  DeleteRegKey HKCU "Software\Classes\gauzzaDocs.xlsx"
  DeleteRegValue HKCU "Software\Classes\.xlsx\OpenWithProgids" "gauzzaDocs.xlsx"
  DeleteRegKey HKCU "Software\Classes\gauzzaDocs.csv"
  DeleteRegValue HKCU "Software\Classes\.csv\OpenWithProgids" "gauzzaDocs.csv"
  DeleteRegKey HKCU "Software\Classes\gauzzaDocs.tsv"
  DeleteRegValue HKCU "Software\Classes\.tsv\OpenWithProgids" "gauzzaDocs.tsv"
  DeleteRegKey HKCU "Software\Classes\gauzzaDocs.pdf"
  DeleteRegValue HKCU "Software\Classes\.pdf\OpenWithProgids" "gauzzaDocs.pdf"
  DeleteRegKey HKCU "Software\Classes\gauzzaDocs.txt"
  DeleteRegValue HKCU "Software\Classes\.txt\OpenWithProgids" "gauzzaDocs.txt"
  DeleteRegKey HKCU "Software\Classes\gauzzaDocs.log"
  DeleteRegValue HKCU "Software\Classes\.log\OpenWithProgids" "gauzzaDocs.log"
  DeleteRegKey HKCU "Software\Classes\gauzzaDocs.json"
  DeleteRegValue HKCU "Software\Classes\.json\OpenWithProgids" "gauzzaDocs.json"
  DeleteRegKey HKCU "Software\Classes\gauzzaDocs.yaml"
  DeleteRegValue HKCU "Software\Classes\.yaml\OpenWithProgids" "gauzzaDocs.yaml"
  DeleteRegKey HKCU "Software\Classes\gauzzaDocs.yml"
  DeleteRegValue HKCU "Software\Classes\.yml\OpenWithProgids" "gauzzaDocs.yml"
  DeleteRegKey HKCU "Software\gauzzaDocs"
  DeleteRegValue HKCU "Software\RegisteredApplications" "gauzzaDocs"
  DeleteRegKey HKCU "Software\Classes\gauzzaDocs.pptx"
  DeleteRegValue HKCU "Software\Classes\.pptx\OpenWithProgids" "gauzzaDocs.pptx"
!macroend
